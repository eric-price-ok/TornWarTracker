<Window x:Class="TornWarTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Torn War Tracker" Height="700" Width="1150">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Player Info Banner -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding PlayerInfoLoaded, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding PlayerName}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" - Level " Foreground="#BDC3C7" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding PlayerLevel}" Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" - " Foreground="#BDC3C7" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding PlayerTitle}" Foreground="#E74C3C" FontStyle="Italic" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="#7F8C8D" VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock Text="{Binding FactionName}" Foreground="#2ECC71" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Setup -->
        <GroupBox Header="Setup" Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="4">
                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                    <TextBlock Text="Torn API Key"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="150" Text="{Binding TornApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Validate" Command="{Binding ValidateApiKeyCommand}" Padding="6,2" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="FFScouter API Key"/>
                    <TextBox Width="180" Text="{Binding FfScouterApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="My Faction ID"/>
                    <TextBox Width="90" Text="{Binding MyFactionId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F0F0F0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="Poll Interval (sec)"/>
                    <TextBox Width="80" Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Padding="10,4"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <Button Content="Start" Command="{Binding StartCommand}" Padding="14,4"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <Button Content="Stop" Command="{Binding StopCommand}" Padding="14,4"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                    <Button Content="Poll Now" Command="{Binding PollNowCommand}" Padding="10,4"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Filters -->
        <GroupBox Header="Filters" Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="4">
                <CheckBox Content="Exclude Traveling" IsChecked="{Binding ExcludeTraveling}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="Exclude Abroad" IsChecked="{Binding ExcludeAbroad}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="Show Online Only" IsChecked="{Binding ShowOnlineOnly}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="45" Text="{Binding MinLevel, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Text=" - " VerticalAlignment="Center"/>
                <TextBox Width="45" Text="{Binding MaxLevel, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="Stat Est." VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="90" Text="{Binding MinStatEstimate, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Text=" - " VerticalAlignment="Center"/>
                <TextBox Width="90" Text="{Binding MaxStatEstimate, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <CheckBox Content="Max FF" IsChecked="{Binding ClaimerMaxFfEnabled}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="50" Text="{Binding ClaimerMaxFf, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- Grid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding MembersView}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="55"/>
                <DataGridTextColumn Header="FF" Binding="{Binding FairFight, StringFormat={}{0:0.00}}" Width="55"/>
                <DataGridTextColumn Header="Est. Stats" Binding="{Binding StatEstimateDisplay}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" SortMemberPath="HospitalMinutesRemaining" Width="180"/>
                <DataGridTextColumn Header="Last Action" Binding="{Binding LastActionDisplay}" Width="120"/>
                <DataGridTemplateColumn Header="Copy" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Copy"
                                    Command="{Binding DataContext.CopyCallerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Padding="6,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Claim" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Claim"
                                    Command="{Binding DataContext.CopyClaimCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Padding="6,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontStyle="Italic"/>
    </Grid>
</Window>
